# Keep the image to the source only: everything generated is re-created on
# first start (inside the container or on the /data volume).
.git

# local Python environments (rebuilt in the image)
.venv/
/terminal/.venv/
__pycache__/
*.pyc
.pytest_cache/

# setup.py outputs, native build trees and downloads (packs, models, logs)
/build/
/build*/
/terminal/build/
/terminal/build*/
/engine/build/
/engine/build*/
/dist/
/packs/
/mtp/
/models/
/Strata-data/
# the folders docker/entrypoint.sh creates in a mounted data/ (a link to llama.cpp, the models, the keys): never part of a build (#3644)
/data/install/
/data/state/
/data/home/
/data/Strata-data/
third_party/llama.cpp/
third_party/*.zip
*.exe
*.dll
*.done
*.log
strata-*.json
strata-*.txt
run-*.sh
run-*.bat
