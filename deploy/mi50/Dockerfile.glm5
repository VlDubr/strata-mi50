# syntax=docker/dockerfile:1
#
# GLM-5.3-Flash on the DeepSeek engine path (strata-dsv41) for MI50 / MI60.  Builds both engines from this tree over the Qwen image
# (strata for Qwen, strata-dsv41 for GLM), so an image holds one source; docs/GLM5.md has the pack, the config and the numbers.
#
# Build from the repository root:
#   docker build -t strata-gfx906:0.2.12-mi50-glm5 -f deploy/mi50/Dockerfile.glm5 .

ARG BASE=strata-gfx906:0.2.12-mi50-vision
FROM ${BASE}

COPY . /tmp/src
# 0.2.19: the build root is engine/ (the split engine); serve/tools/ data live under terminal/.
# The vendored engine/third_party/strata-ggml sits at the fork's llama.cpp pin (3cf03257), so no -DSTRATA_GGML_DIR.
RUN cmake -S /tmp/src/engine -B /tmp/q -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DSTRATA_HIP_GFX906=ON -DCMAKE_HIP_ARCHITECTURES=gfx906 \
        -DSTRATA_PORTABLE=ON -DSTRATA_BUILD_TESTS=OFF \
        -DCMAKE_C_COMPILER=/usr/bin/cc -DCMAKE_CXX_COMPILER=/usr/bin/c++ \
        -DCMAKE_HIP_COMPILER=/opt/rocm/llvm/bin/clang++ -DCMAKE_PREFIX_PATH=/opt/rocm \
    && cmake --build /tmp/q -j "$(nproc)" --target strata \
    && cp /tmp/q/strata /opt/strata/engine/strata \
    && mkdir -p /opt/strata/terminal/engine \
    && cp /tmp/q/strata /opt/strata/terminal/engine/strata \
    && rm -rf /tmp/q
RUN cmake -S /tmp/src/engine -B /tmp/b -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DSTRATA_ENABLE_HIP=ON -DSTRATA_ENABLE_CUDA=OFF -DSTRATA_EXPERIMENTAL_GFX906=ON -DCMAKE_HIP_ARCHITECTURES=gfx906 \
        -DSTRATA_BUILD_TESTS=OFF -DSTRATA_BUILD_DSV41=ON -DSTRATA_NATIVE_EXPERTS=ON -DSTRATA_PORTABLE=ON \
        -DCMAKE_C_COMPILER=/usr/bin/cc -DCMAKE_CXX_COMPILER=/usr/bin/c++ \
        -DCMAKE_HIP_COMPILER=/opt/rocm/llvm/bin/clang++ -DCMAKE_PREFIX_PATH=/opt/rocm \
    && cmake --build /tmp/b -j "$(nproc)" --target strata-dsv41 \
    && cp /tmp/b/strata-dsv41 /opt/strata/engine/strata-dsv41 \
    && cp -r /tmp/src/terminal/serve/. /opt/strata/terminal/serve/ \
    && cp /tmp/src/terminal/tools/strata_tokenizer.py /opt/strata/terminal/tools/ \
    && mkdir -p /opt/strata/terminal/tools/dsv41 \
    && cp /tmp/src/terminal/tools/dsv41/pack_gguf.py /opt/strata/terminal/tools/dsv41/ \
    && cp /tmp/src/terminal/tools/dsv41/pack_glm5.py /opt/strata/terminal/tools/dsv41/ \
    && cp /tmp/src/deploy/mi50/glm5-entry.sh /opt/strata/glm5-entry.sh \
    && chmod 755 /opt/strata/glm5-entry.sh \
    && rm -rf /tmp/src /tmp/b

ENTRYPOINT ["/opt/strata/glm5-entry.sh"]
